panel.env

# 日志与临时产物
*.log
*.pid
*.bak
*.tmp

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本机上游注册表（按机器路径定制，不入库）
upstreams.json

# 各服务自己的密钥文件
services/*/.env
services/*/data/
