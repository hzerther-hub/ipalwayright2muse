{
  "site": "https://app.pavo-ai.cn/",
  "api_host": "https://api.pavo-ai.cn",
  "api_base": "https://api.pavo-ai.cn/api",
  "_base_note": "前端 NEXT_PUBLIC_API_URL = https://api.pavo-ai.cn/api —— 前面还有一层 /api 前缀，漏了会得到 code 000201 Resource not found。",
  "regions": [
    "cn",
    "intl"
  ],
  "note": "内部接口清单，由 tools/_probe_pavo.py 从 Next.js chunk 里扒出。路径为相对 API_BASE 的路径。",
  "public_endpoints": {
    "_note": "无需登录即可调用（实测 code=000000）",
    "models": "GET /v1/pixa/models",
    "model_capability_spec": "GET /v1/aigc/model-capability-spec?model_code=<code>",
    "support_modes": "GET /v1/pixa/support_modes"
  },
  "auth_required": {
    "_note": "无 token 时返回 code=000501 Login expired",
    "login": "POST /v1/user/login",
    "register": "POST /v1/user/register",
    "phone_otp": "POST /v1/user/auth/phone-otp",
    "send_code": "POST /v1/user/code/send",
    "captcha_status": "GET /v1/user/captcha/status",
    "auth_methods": "GET /v1/user/auth_methods",
    "bind_phone": "POST /v1/user/bind_phone",
    "bind_wechat": "POST /v1/user/bind_wechat",
    "reset_password": "POST /v1/user/reset_password",
    "influencer_invite_bind": "POST /v1/user/influencer-invite/bind",
    "account": "GET /v1/user/account",
    "profile": "GET /v1/user/profile",
    "avatar_presigned": "GET /v1/user/avatar/presigned-url"
  },
  "credits": {
    "estimate": "POST /v1/aigc/credits/estimate",
    "calculate": "POST /v1/aigc/credits/calculate",
    "voice_generate_credits": "POST /v1/pixa/short-drama/voices/generate/credits"
