    "projects_ai_generate": "POST /v1/pixa/short-drama/projects/ai-generate",
    "projects_create": "POST /v1/pixa/short-drama/projects/",
    "projects_upload": "POST /v1/pixa/short-drama/projects/upload",
    "projects_paste": "POST /v1/pixa/short-drama/projects/paste",
    "projects_batch_delete": "POST /v1/pixa/short-drama/projects/batch-delete",
